-- 1. TEXTO RAINBOW SOBRE LA CABEZA
--------------------------------------------------------------------
local billboard = nil

local function crearTextoCabeza(player)
	local character = player.Character or player.CharacterAdded:Wait()
	local head = character:WaitForChild("Head", 5)
	if not head then return end

	if head:FindFirstChild("MireliaTag") then
		head.MireliaTag:Destroy()
	end

	billboard = Instance.new("BillboardGui")
	billboard.Name = "MireliaTag"
	billboard.Adornee = head
	billboard.Size = UDim2.new(0, 250, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 2.8, 0)
	billboard.AlwaysOnTop = true

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = "✨ MIRELIÁ HUB ✨"
	textLabel.TextScaled = true
	textLabel.Font = Enum.Font.FredokaOne
	textLabel.Parent = billboard

	billboard.Parent = head

	task.spawn(function()
		local hue = 0
		while billboard and billboard.Parent do
			hue = (hue + 0.006) % 1
			textLabel.TextColor3 = Color3.fromHSV(hue, 0.8, 1)
			task.wait(0.03)
		end
	end)
end

if LocalPlayer.Character then
	crearTextoCabeza(LocalPlayer)
end
LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1)
	crearTextoCabeza(LocalPlayer)
end)

