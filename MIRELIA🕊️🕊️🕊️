-- Mapa de temas nativos soportados por Rayfield
local themeMap = {
	["Azul cielo"] = "Ocean",
	["Morado / Púrpura"] = "Amethyst",
	["Rojo Oscuro"] = "DarkBlue",
	["Amarillo / Ámbar"] = "AmberGlow",
	["Verde Esmeralda"] = "Green",
	["Tema Oscuro"] = "Default"
}

TabInfo:CreateDropdown({
	Name = "Seleccionar Color del Panel",
	Options = {"Morado / Púrpura", "Azul cielo", "Rojo Oscuro", "Amarillo / Ámbar", "Verde Esmeralda", "Tema Oscuro"},
	CurrentOption = "Morado / Púrpura",
	Flag = "ColorThemeDropdown",
	Callback = function(Option)
		local selectedOption = type(Option) == "table" and Option[1] or Option
		local targetTheme = themeMap[selectedOption] or "Amethyst"
		
		-- Cambio de tema dinámico compatible con Rayfield
		pcall(function()
			if Rayfield.ModifyTheme then
				Rayfield:ModifyTheme(targetTheme)
			elseif Window.ModifyTheme then
				Window:ModifyTheme(targetTheme)
			else
				Rayfield:SetTheme(targetTheme)
			end
		end)
	end,
})

